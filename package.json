{
  "name": "@nakak10/visual-review",
  "version": "1.0.0-beta.1",
  "private": false,
  "description": "Local visual review and annotation workflow for AI-assisted UI fixes",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist/src"
  ],
  "bin": {
    "visual-review": "dist/src/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NAKAK10/visual-review.git"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "node scripts/copy-ui.mjs --clean && tsc -p tsconfig.json && node scripts/copy-ui.mjs && node scripts/make-cli-executable.mjs",
    "start": "node dist/src/cli.js serve",
    "check:secrets": "node scripts/check-secrets.mjs",
    "pretest": "npm run check:secrets",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:jobs": "npm run build && node --test dist/test/jobs.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.7.0"
  }
}
