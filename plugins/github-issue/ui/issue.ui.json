{
  "schema_version": 1,
  "local_state": [
    { "key": "issue_open", "type": "boolean", "default": false, "persist": false, "lifetime": "dialog" },
    { "key": "title", "type": "text", "default": "", "max_length": 256, "persist": false, "lifetime": "dialog", "reset_on_success": true },
    { "key": "body", "type": "text", "default": "", "max_length": 65536, "persist": false, "lifetime": "dialog", "reset_on_success": true }
  ],
  "resources": [
    { "id": "issue-target", "query": "issue.target", "input": {}, "refresh": "event" }
  ],
  "root": { "type": "stack", "children": [
    { "id": "issue-draft", "type": "button", "when": { "and": [{ "eq": [{ "slot_context": "/status" }, { "literal": "addressed" }] }, { "eq": [{ "slot_context": "/issue_state" }, { "literal": "ready" }] }] }, "props": { "label": { "literal": "GitHub Issueにする" }, "variant": { "literal": "secondary" } }, "on": { "click": [{ "type": "command.execute", "command": "issue.draft", "input": { "annotation_id": { "slot_context": "/id" } }, "pending": { "disable": "issue-draft", "deduplicate": true }, "on_success": [{ "type": "local.set", "path": "/title", "value": { "result": "/title" } }, { "type": "local.set", "path": "/body", "value": { "result": "/body" } }, { "type": "dialog.open", "dialog": "issue-dialog" }], "on_error": [{ "type": "toast.show", "variant": "error", "message": { "error": "/message" } }] }] } },
    { "id": "issue-dialog", "type": "dialog", "props": { "open": { "local": "/issue_open" }, "title": { "literal": "Issueラフを確認" }, "description": { "literal": "AIが作成したラフを確認し、必要に応じて編集してからGitHubへ追加します。" }, "initial_focus": { "literal": "issue-title" }, "return_focus": { "literal": "issue-draft" }, "dismissible": { "literal": true }, "mobile_presentation": { "literal": "fullscreen" } }, "children": [
      { "type": "form", "props": { "name": { "literal": "issue" }, "submit_on_enter": { "literal": true } }, "on": { "submit": [{ "type": "command.execute", "command": "issue.create", "input": { "annotation_id": { "slot_context": "/id" }, "title": { "form": "title" }, "body": { "form": "body" } }, "pending": { "deduplicate": true }, "on_success": [{ "type": "dialog.close", "dialog": "issue-dialog" }, { "type": "toast.show", "variant": "success", "message": { "literal": "GitHubにIssueを追加しました" } }], "on_error": [{ "type": "toast.show", "variant": "error", "message": { "error": "/message" } }] }] }, "children": [
        { "type": "stack", "props": { "variant": { "literal": "issue-target" }, "gap": { "literal": "none" } }, "children": [
          { "type": "row", "props": { "variant": { "literal": "issue-target-line" } }, "when": { "exists": { "resource": "issue-target", "path": "/repo" } }, "children": [
            { "type": "text", "props": { "text": { "literal": "repo:" }, "variant": { "literal": "form-help" } } },
            { "type": "text", "props": { "text": { "resource": "issue-target", "path": "/repo" }, "variant": { "literal": "form-help" } } }
          ] },
          { "type": "row", "props": { "variant": { "literal": "issue-target-line" } }, "when": { "exists": { "resource": "issue-target", "path": "/account" } }, "children": [
            { "type": "text", "props": { "text": { "literal": "account:" }, "variant": { "literal": "form-help" } } },
            { "type": "text", "props": { "text": { "resource": "issue-target", "path": "/account" }, "variant": { "literal": "form-help" } } }
          ] }
        ] },
        { "id": "issue-title", "type": "input", "props": { "name": { "literal": "title" }, "label": { "literal": "タイトル" }, "value": { "local": "/title" }, "required": { "literal": true }, "max_length": { "literal": 256 } } },
        { "type": "textarea", "props": { "name": { "literal": "body" }, "label": { "literal": "本文" }, "value": { "local": "/body" }, "required": { "literal": true }, "max_length": { "literal": 65536 }, "rows": { "literal": 14 } } },
        { "type": "row", "children": [
          { "type": "button", "props": { "label": { "literal": "キャンセル" } }, "on": { "click": [{ "type": "dialog.close", "dialog": "issue-dialog" }] } },
          { "type": "button", "props": { "label": { "literal": "GitHubにIssueを追加" }, "variant": { "literal": "primary" }, "type": { "literal": "submit" } } }
        ] }
      ] }
    ] },
    { "type": "link", "when": { "eq": [{ "slot_context": "/issue_state" }, { "literal": "created" }] }, "props": { "label": { "literal": "Issueを開く" }, "href": { "slot_context": "/issue_url" }, "external": { "literal": true } } }
  ] }
}
