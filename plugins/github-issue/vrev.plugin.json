{
  "schema_version": 4,
  "id": "github-issue",
  "version": "1.0.0-beta.2",
  "display": {
    "title": "GitHub Issue",
    "summary": "レビューから確認済みのGitHub Issueを作成します。",
    "readme": "./README.md"
  },
  "configuration": [],
  "issue_provider": {
    "module": "./index.js"
  },
  "server": {
    "api_version": 1,
    "bridge_api_version": 1,
    "module": "./server/index.js",
    "contract": "./server.contract.json"
  },
  "ui": {
    "renderer_api_version": 1,
    "bridge_api_version": 1,
    "contributions": [
      {
        "id": "issue-header",
        "slot": "review.header",
        "document": "./ui/header.ui.json",
        "order": 100,
        "title": "GitHub Issue"
      },
      {
        "id": "issue-sidebar",
        "slot": "review.sidebar",
        "document": "./ui/sidebar.ui.json",
        "order": 200,
        "title": "GitHub Issues"
      }
    ]
  },
  "requires": [
    {
      "capability": "review",
      "api_version": 1,
      "optional": false
    },
    {
      "capability": "ai",
      "api_version": 1,
      "optional": false
    }
  ],
  "provides": [
    {
      "capability": "issue-task",
      "api_version": 1
    }
  ]
}
