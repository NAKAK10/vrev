{
  "schema_version": 1,
  "resources": [
    {
      "id": "workflow-settings",
      "query": "workflow.settings",
      "input": {},
      "refresh": "event"
    }
  ],
  "root": {
    "type": "section",
    "props": {
      "title": {
        "literal": "注釈ワークフロー設定"
      },
      "description": {
        "literal": "最大並列数と注釈保存後の自動実行を設定します。利用するAIはAIパッケージで設定します。"
      }
    },
    "children": [
      {
        "type": "select",
        "props": {
          "name": {
            "literal": "max_parallel"
          },
          "label": {
            "literal": "最大並列数"
          },
          "value": {
            "resource": "workflow-settings",
            "path": "/max_parallel"
          },
          "options": {
            "resource": "workflow-settings",
            "path": "/parallel_options"
          }
        },
        "on": {
          "change": [
            {
              "type": "command.execute",
              "command": "workflow.settings.update",
              "input": {
                "max_parallel": {
                  "event": "/value"
                },
                "auto_run": {
                  "resource": "workflow-settings",
                  "path": "/auto_run"
                }
              },
              "pending": {
                "deduplicate": true
              },
              "on_success": [
                {
                  "type": "resource.refresh",
                  "resource": "workflow-settings"
                },
                {
                  "type": "toast.show",
                  "variant": "success",
                  "message": {
                    "literal": "注釈ワークフロー設定を保存しました"
                  }
                }
              ],
              "on_error": [
                {
                  "type": "toast.show",
                  "variant": "error",
                  "message": {
                    "error": "/message"
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "type": "switch",
        "props": {
          "name": {
            "literal": "auto_run"
          },
          "label": {
            "literal": "注釈を保存したら自動でAI修正を開始"
          },
          "checked": {
            "resource": "workflow-settings",
            "path": "/auto_run"
          }
        },
        "on": {
          "change": [
            {
              "type": "command.execute",
              "command": "workflow.settings.update",
              "input": {
                "max_parallel": {
                  "resource": "workflow-settings",
                  "path": "/max_parallel"
                },
                "auto_run": {
                  "event": "/value"
                }
              },
              "pending": {
                "deduplicate": true
              },
              "on_success": [
                {
                  "type": "resource.refresh",
                  "resource": "workflow-settings"
                },
                {
                  "type": "toast.show",
                  "variant": "success",
                  "message": {
                    "literal": "注釈ワークフロー設定を保存しました"
                  }
                }
              ],
              "on_error": [
                {
                  "type": "toast.show",
                  "variant": "error",
                  "message": {
                    "error": "/message"
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "type": "safe-markdown",
        "props": {
          "value": {
            "slot_context": "/readme"
          }
        }
      }
    ]
  }
}
