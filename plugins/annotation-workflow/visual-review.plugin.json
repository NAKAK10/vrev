{
  "schema_version": 4,
  "id": "annotation-workflow",
  "version": "1.3.0",
  "display": {
    "title": "注釈ワークフロー",
    "summary": "注釈保存後のAI自動実行と設定UIのポリシーを提供します。",
    "readme": "./README.md"
  },
  "configuration": [],
  "annotation_flow_provider": {
    "api_version": 1,
    "module": "./index.js"
  },
  "server": {
    "api_version": 1,
    "bridge_api_version": 1,
    "module": "./server/index.js",
    "contract": "./server.contract.json"
  },
  "ui": {
    "renderer_api_version": 1,
    "bridge_api_version": 1,
    "extension_points": [
      {
        "id": "annotation-workflow.annotation.actions",
        "title": "注釈カードの操作",
        "context_schema": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "maxLength": 128 },
            "status": { "type": "string", "maxLength": 32 },
            "issue_state": { "type": "string", "maxLength": 32 },
            "issue_url": { "type": "string", "maxLength": 2048 }
          },
          "required": ["id", "status"],
          "additionalProperties": true
        },
        "max_contributions": 8
      }
    ],
    "contributions": [
      {
        "id": "review-sidebar",
        "slot": "review.sidebar",
        "document": "./ui/sidebar.ui.json",
        "browser_module": "./ui/sidebar.js",
        "order": 100,
        "title": "注釈ワークフロー"
      },
      {
        "id": "workflow-settings",
        "slot": "settings.detail",
        "document": "./ui/settings.ui.json",
        "order": 100
      }
    ]
  },
  "requires": [
    {
      "capability": "review",
      "api_version": 1,
      "optional": false
    },
    {
      "capability": "host.process-supervisor",
      "api_version": 1,
      "optional": false
    },
    {
      "capability": "runner-registry",
      "api_version": 1,
      "optional": true
    },
    {
      "capability": "issue-task",
      "api_version": 1,
      "optional": true
    }
  ],
  "provides": [
    {
      "capability": "annotation-workflow",
      "api_version": 1
    }
  ]
}
