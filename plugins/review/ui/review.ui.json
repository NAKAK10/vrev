{
  "schema_version": 1,
  "local_state": [
    { "key": "viewport", "type": "enum", "values": ["desktop", "tablet", "mobile", "custom"], "default": "desktop", "persist": true, "schema_version": 2 },
    { "key": "viewport_width", "type": "integer", "default": 1280, "min": 320, "max": 3840, "persist": true, "schema_version": 1 },
    { "key": "viewport_height", "type": "integer", "default": 720, "min": 240, "max": 2160, "persist": true, "schema_version": 1 },
    { "key": "selection_mode", "type": "enum", "values": ["browse", "node", "region"], "default": "browse", "persist": false },
    { "key": "comment_open", "type": "boolean", "default": false, "persist": false, "lifetime": "dialog" },
    { "key": "comment", "type": "text", "default": "", "max_length": 2000, "persist": false, "lifetime": "dialog", "reset_on_success": true }
  ],
  "resources": [
    { "id": "session", "query": "session.get", "input": {}, "refresh": "event" }
  ],
  "root": {
    "type": "app-shell",
    "props": { "title": { "literal": "Visual Redline Review" } },
    "children": [
      { "type": "header", "children": [
        { "type": "link", "when": { "eq": [{ "resource": "session", "path": "/features/plugin_management" }, { "literal": true }] }, "props": { "label": { "literal": "設定" }, "href": { "literal": "/settings/plugins" } } },
        { "type": "heading", "props": { "text": { "resource": "session", "path": "/target/entry_path" }, "level": { "literal": 1 } } },
        { "type": "toolbar", "props": { "label": { "literal": "レビュー操作" }, "overflow": { "literal": "menu" } }, "children": [
          { "id": "viewport", "type": "viewport-selector", "props": { "value": { "local": "/viewport" }, "options": { "literal": [{ "value": "desktop", "label": "PC" }, { "value": "tablet", "label": "タブレット" }, { "value": "mobile", "label": "スマホ" }, { "value": "custom", "label": "カスタム" }] }, "label": { "literal": "表示サイズ" } }, "on": { "change": [{ "type": "local.set", "path": "/viewport", "value": { "event": "/value" } }] } },
          { "type": "row", "when": { "eq": [{ "local": "/viewport" }, { "literal": "custom" }] }, "props": { "variant": { "literal": "custom-viewport-size" } }, "children": [
            { "id": "viewport-width", "type": "input", "props": { "label": { "literal": "幅 (px)" }, "value": { "local": "/viewport_width" }, "type": { "literal": "number" }, "min": { "literal": 320 }, "max": { "literal": 3840 }, "required": { "literal": true } }, "on": { "change": [{ "type": "local.set", "path": "/viewport_width", "value": { "event": "/value" } }] } },
            { "id": "viewport-height", "type": "input", "props": { "label": { "literal": "高さ (px)" }, "value": { "local": "/viewport_height" }, "type": { "literal": "number" }, "min": { "literal": 240 }, "max": { "literal": 2160 }, "required": { "literal": true } }, "on": { "change": [{ "type": "local.set", "path": "/viewport_height", "value": { "event": "/value" } }] } }
          ] },
          { "id": "selection-mode", "type": "selection-mode-selector", "props": { "value": { "local": "/selection_mode" }, "options": { "literal": [{ "value": "browse", "label": "閲覧" }, { "value": "node", "label": "ノード" }, { "value": "region", "label": "範囲" }] }, "label": { "literal": "選択モード" } }, "on": { "change": [{ "type": "local.set", "path": "/selection_mode", "value": { "event": "/value" } }] } },
          { "type": "button", "props": { "label": { "literal": "再読み込み" }, "variant": { "literal": "secondary" } }, "on": { "click": [{ "type": "target.reload" }] } }
        ] }
      ] },
      { "type": "split-panel", "props": { "collapse": { "literal": "stack" }, "primary_order": { "literal": "first" }, "empty_slot": { "literal": "expand" } }, "children": [
        { "type": "section", "props": { "label": { "literal": "レビュー対象" } }, "children": [
          { "id": "review-target", "type": "target-stage", "props": { "target": { "resource": "session", "path": "/target" }, "target_kind": { "resource": "session", "path": "/target/kind" }, "trust_mode": { "resource": "session", "path": "/target/trust_mode" }, "viewport_mode": { "local": "/viewport" }, "viewport_width": { "local": "/viewport_width" }, "viewport_height": { "local": "/viewport_height" }, "selection_mode": { "local": "/selection_mode" }, "enabled": { "literal": true } }, "on": { "selection-commit": [{ "type": "dialog.open", "dialog": "comment-dialog" }] } },
          { "type": "annotation-mark-layer", "props": { "marks": { "resource": "session", "path": "/review/annotations" }, "resolved_policy": { "literal": "selected" }, "stale_policy": { "literal": "fallback" }, "enabled": { "literal": true } } },
          { "type": "slot", "props": { "name": { "literal": "review.overlays" } } }
        ] },
        { "type": "slot", "props": { "name": { "literal": "review.sidebar" }, "empty_slot": { "literal": "expand" } } }
      ] },
      { "id": "comment-dialog", "type": "dialog", "props": { "open": { "local": "/comment_open" }, "title": { "literal": "コメントを追加" }, "variant": { "literal": "comment-dialog" }, "description": { "literal": "選択した対象への修正内容または確認事項を入力してください。" }, "initial_focus": { "literal": "comment-input" }, "return_focus": { "literal": "review-target" }, "dismissible": { "literal": true }, "mobile_presentation": { "literal": "fullscreen" } }, "children": [
        { "type": "form", "props": { "name": { "literal": "annotation" }, "submit_on_enter": { "literal": true }, "variant": { "literal": "comment-form" } }, "on": { "submit": [{ "type": "command.execute", "command": "annotation.create", "input": { "anchor": { "slot_context": "/review/selection/anchor" }, "comment": { "form": "comment" } }, "expected_revision": { "resource": "session", "path": "/review/revision" }, "pending": { "deduplicate": true }, "on_success": [{ "type": "dialog.close", "dialog": "comment-dialog" }, { "type": "resource.refresh", "resource": "session" }, { "type": "toast.show", "variant": "success", "message": { "literal": "注釈を保存しました" } }], "on_error": [{ "type": "toast.show", "variant": "error", "message": { "error": "/message" } }] }] }, "children": [
          { "id": "comment-input", "type": "textarea", "props": { "name": { "literal": "comment" }, "label": { "literal": "修正内容・確認事項" }, "value": { "local": "/comment" }, "required": { "literal": true }, "max_length": { "literal": 2000 } } },
          { "type": "row", "props": { "variant": { "literal": "dialog-actions" } }, "children": [
            { "type": "button", "props": { "label": { "literal": "キャンセル" } }, "on": { "click": [{ "type": "dialog.close", "dialog": "comment-dialog" }] } },
            { "type": "button", "props": { "label": { "literal": "注釈を保存" }, "type": { "literal": "submit" }, "variant": { "literal": "primary" } } }
          ] }
        ] }
      ] },
      { "type": "toast-region", "props": { "label": { "literal": "通知" } } }
    ]
  }
}
